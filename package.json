{
  "name": "oneemergence-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:a11y": "playwright test tests/a11y",
    "test:content": "playwright test tests/content",
    "test:perf": "playwright test tests/performance",
    "test:mobile": "playwright test tests/smoke/responsive",
    "test:world-assets": "node scripts/validate-world-map-glb.mjs public/models/world-map/tree/tree-optimized.glb",
    "test:journal-lifecycle": "node scripts/test-journal-lifecycle.mjs",
    "test:accounts:local": "node scripts/test-accounts-local.mjs",
    "test:journal-autosave": "playwright test --config=playwright.unit.config.ts",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.116",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.115.0",
    "ai": "^6.0.276",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.40.0",
    "next": "16.2.1",
    "next-intl": "^4.14.2",
    "next-mdx-remote": "^6.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/env": "16.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@gltf-transform/cli": "^4.5.0",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.185.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.1",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
