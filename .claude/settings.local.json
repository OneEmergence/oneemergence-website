{
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/secret/**)",
      "Read(**/credentials/**)",
      "Read(**/credential/**)",
      "Read(**/certs/**)",
      "Read(**/keys/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.crt)",
      "Read(**/*.kubeconfig)",
      "Read(**/service-account*.json)",
      "Read(**/firebase-adminsdk*.json)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.azure/**)",
      "Read(**/.gcp/**)",

      "Bash(cat *env*)",
      "Bash(cat **/.env*)",
      "Bash(cat **/secrets/**)",
      "Bash(cat **/secret/**)",
      "Bash(cat **/credentials/**)",
      "Bash(less **/.env*)",
      "Bash(more **/.env*)",
      "Bash(head **/.env*)",
      "Bash(tail **/.env*)",
      "Bash(grep * .env*)",
      "Bash(grep * **/.env*)",
      "Bash(rg * .env*)",
      "Bash(rg * **/.env*)",
      "Bash(find * -name .env*)",
      "Bash(find * -name '*.pem')",
      "Bash(find * -name '*.key')",
      "Bash(find * -path '*secrets*')",
      "Bash(find * -path '*credentials*')",
      "Bash(python* *open*env*)",
      "Bash(node* *readFile*env*)"
    ],
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(npx ng:*)",
      "Bash(PYTHONPATH=. /Users/juliusharnack/git/mosaic/services/hannibal/.venv/bin/python3:*)",
      "Bash(shutdown:*)"
    ]
  }
}
